# Production Environment Configuration
# Use this file when deploying with docker-compose
# Command: docker-compose --env-file .env.prod up

# ── Database Configuration ─────────────────────────────────────────────────────
POSTGRES_USER=pos
POSTGRES_PASSWORD=your_secure_password_here_change_in_production
POSTGRES_DB=pos_db

# ── JWT Configuration ─────────────────────────────────────────────────────────
JWT_SECRET=your_secure_jwt_secret_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_secure_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ── Corporate Proxy (uncomment if needed) ──────────────────────────────────────
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080
