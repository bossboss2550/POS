# ─── Docker Environment Configuration ─────────────────────────────────────────
# Copy this to .env.docker and update with your values

# ─── Database Configuration ───────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pos_db
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/pos_db

# ─── API Configuration ────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=production

# ─── JWT Configuration ────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS Configuration ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8005

# ─── Frontend Configuration ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:8001/api/v1
VITE_APP_NAME=POS System
